# Required — your Sakana Fugu API key (kept server-side only)
SAKANA_API_KEY=fish_xxx

# Optional overrides
SAKANA_BASE_URL=https://api.sakana.ai/v1
SAKANA_MODEL=fugu
# CARA_SYSTEM_PROMPT="You are CARA..."

# Supabase — user accounts + per-user conversation storage.
# SUPABASE_URL and SUPABASE_ANON_KEY are public (the anon key is for browsers).
# SUPABASE_SERVICE_KEY stays server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
